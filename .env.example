# Spring profile
SPRING_PROFILES_ACTIVE=prod

# External MySQL database
DB_URL=jdbc:mysql://<host>:3306/<database>
DB_USERNAME=
DB_PASSWORD=
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# JWT (use long, randomly generated values in the real environment file)
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=180
JWT_REFRESH_TOKEN_EXPIRATION=12096000

# Runtime
UPLOAD_PATH=/var/lib/hobbyloop/uploads
CORS_ALLOWED_ORIGINS=https://example.com
SERVER_PORT=8080
SERVER_ADDRESS=0.0.0.0

# Frontend build
VITE_API_BASE_URL=/api

# Optional host port for Nginx
HTTP_PORT=80

# External Redis connection
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false